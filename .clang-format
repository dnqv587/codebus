#***********************************************
# codebus 代码格式规范（基准：clang-format Google；正文规范覆盖项见注释）
# 基准变更：大括号同行（Attach，对齐 code_style.md 更新后的示例）；
# 保留项目项：4 空格缩进、` public:` 一空格、include 手工语义序、单行内联函数
#***********************************************
---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 120              # 正文未限列宽；贴合现状（实测 p99=94）

# ---- 缩进（正文规范：4 空格，覆盖 Google 的 2）----
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4
AccessModifierOffset: -3       # ` public:` 前一空格（正文规范）
IndentCaseLabels: true         # case 相对 switch 缩进一级（现有代码形态）
NamespaceIndentation: None
CompactNamespaces: false
IndentPPDirectives: None

# ---- 大括号：同行（Google 基准；code_style.md 更新后示例形态）----
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: All       # 单行内联 getter `{ return m_x; }` 保留
AllowShortLambdasOnASingleLine: All         # `[this] { sweep(); }` 单行 lambda 保留
AllowShortIfStatementsOnASingleLine: Never  # if 体保持换行（项目现状）
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# ---- 指针 / 引用贴类型（Google 基准一致，显式声明防漂移）----
PointerAlignment: Left
DerivePointerAlignment: false

# ---- 对齐 / 换行 ----
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignEscapedNewlines: Right
AlignOperands: Align
AlignTrailingComments: true
BreakBeforeBinaryOperators: None
BreakConstructorInitializers: BeforeColon
AlwaysBreakTemplateDeclarations: Yes
PackConstructorInitializers: CurrentLine

# ---- 空格 ----
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
BitFieldColonSpacing: Both

# ---- include：正文语义序（对应头→项目→标准库→第三方）优先于 Google 排序 ----
SortIncludes: Never
IncludeBlocks: Preserve

# ---- 其他 ----
FixNamespaceComments: true     # `}  // namespace bus`
KeepEmptyLinesAtTheStartOfBlocks: true
MaxEmptyLinesToKeep: 1
Cpp11BracedListStyle: true
# 属性宏注册（正文规则：属性宏后换行与函数声明分开；Macro.h 全集）
AttributeMacros:
  - ATTR_NODISCARD
  - ATTR_PURE_INLINE
  - ATTR_INLINE
  - ATTR_PURE
  - ATTR_CONST
  - ATTR_CONST_INLINE

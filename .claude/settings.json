{
    "autoMemoryEnabled": true,
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Read",
            "Bash(npm *)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git status *)",
            "Bash(cmake *)",
            "Bash(make *)",
            "Bash(ls *)",
            "Bash(sed *)",
            "Bash(cd *)",
            "Bash(* --version)",
            "Bash(* --help *)",
            "Bash(grep *)"
        ],
        "ask":[
            "Bash(rm *)",
            "Bash(mkdir *)"
        ],
        "deny":[
            "Bash(git commit *)",
            "Bash(git push *)"
        ]
    },
    "excluded_files": [
        ".git/*"
    ],
    "language_preferences": {
        "documentation": "zh-CN",
        "code_comments": "zh-CN"
    }
}